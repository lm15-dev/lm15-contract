          }
        },
        "required": [
          "v"
        ]
      },
      "openapi": true,
      "why": "the OpenAPI field reads it; the JSON Schema field wants a boolean"
    },
    {
      "id": "description-not-a-string",
      "schema": {
        "type": "object",
        "properties": {
          "v": {
            "type": "string",
            "description": 5
          }
        },
