      "expect": {"valid": false}
    },
    {
      "id": "complete-requires-committed-result",
      "base": "cancelled-attempt-has-no-private-state",
      "patch": [{"op": "replace", "path": "/scopes/0/attempts/0/state", "value": "complete"}],
      "expect": {"valid": false}
    }
  ]
}
