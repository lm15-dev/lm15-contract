{
  "id": "typesafe.image_format_refused",
  "provider": "typesafe",
  "feature": "judgments_image",
  "description": "A WebP image → refuse at the part: systemone reads PNG or JPEG assets only, and lm15 never converts media (D4)",
  "expect_lm15": {
    "raises": {
      "op": "build_request",
      "type": "UnsupportedFeatureError",
      "code": "unsupported_feature",
      "feature": "messages[0].parts[0]"
    }
  },
  "provenance": {
    "source": "hand-authored",
    "date": "2026-10-14",
    "evidence": "changes/2026-10-14-jev-images.md D4 (MAP-10 rule 1: inline PNG or JPEG bytes reach the wire, or the build raises; lm15 never fetches or converts media)"
  },
  "canonical_request": {
    "model": "jev-latest",
    "messages": [
      {
        "role": "user",
        "parts": [
          {
            "type": "image",
            "media_type": "image/webp",
            "data": "UklGRg=="
          }
        ]
      }
    ],
    "config": {
      "response_format": {
        "type": "json_schema",
        "name": "judgments",
        "strict": true,
        "schema": {
          "type": "object",
          "properties": {
            "red": {
              "type": "boolean",
              "description": "Is the shape red?"
            }
          },
          "required": [
            "red"
          ],
          "additionalProperties": false
        }
      }
    }
  },
  "canonical_request_provenance": {
    "source": "hand-authored",
    "date": "2026-10-14",
    "evidence": "authored with the case; changes/2026-10-14-jev-images.md D4"
  }
