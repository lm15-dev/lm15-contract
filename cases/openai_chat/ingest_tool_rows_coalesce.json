{
  "id": "openai_chat.ingest_tool_rows_coalesce",
  "provider": "openai_chat",
  "feature": "ingest_tool_rows_coalesce",
  "surface": "ingest",
  "description": "Two tool rows after an assistant turn with two calls read as ONE tool Message with two ToolResultParts (the builder writes one row per result part, so this is its inverse); a tool row's name is the result's function name and maps.",
  "body": {
    "model": "gpt-5-mini",
    "messages": [
      {
        "role": "user",
        "content": "Weather in Paris and Lyon?"
      },
      {
        "role": "assistant",
        "content": null,
        "tool_calls": [
          {
            "id": "call_1",
            "type": "function",
            "function": {
              "name": "get_weather",
              "arguments": "{\"city\":\"Paris\"}"
            }
          },
          {
            "id": "call_2",
            "type": "function",
            "function": {
              "name": "get_weather",
              "arguments": "{\"city\":\"Lyon\"}"
            }
          }
        ]
      },
      {
        "role": "tool",
        "tool_call_id": "call_1",
        "name": "get_weather",
        "content": "18C"
      },
      {
        "role": "tool",
        "tool_call_id": "call_2",
        "content": "21C"
      }
    ],
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "get_weather",
          "description": "Current weather for a city.",
          "parameters": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string"
              }
            },
            "required": [
              "city"
            ]
          }
        }
      }
    ]
  },
  "expect_lm15": {
    "canonical_request": {
      "model": "gpt-5-mini",
      "messages": [
        {
          "role": "user",
          "parts": [
            {
              "type": "text",
              "text": "Weather in Paris and Lyon?"
            }
          ]
        },
        {
          "role": "assistant",
          "parts": [
            {
              "type": "tool_call",
              "id": "call_1",
              "name": "get_weather",
              "input": {
                "city": "Paris"
              }
            },
            {
              "type": "tool_call",
              "id": "call_2",
              "name": "get_weather",
              "input": {
                "city": "Lyon"
              }
            }
          ]
        },
        {
          "role": "tool",
          "parts": [
            {
              "type": "tool_result",
              "id": "call_1",
              "content": [
                {
                  "type": "text",
                  "text": "18C"
                }
              ],
              "name": "get_weather"
            },
            {
              "type": "tool_result",
              "id": "call_2",
              "content": [
                {
                  "type": "text",
                  "text": "21C"
                }
              ]
            }
          ]
        }
      ],
      "tools": [
        {
          "type": "function",
          "name": "get_weather",
          "description": "Current weather for a city.",
          "parameters": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string"
              }
            },
            "required": [
              "city"
            ]
          }
        }
      ]
    }
  },
