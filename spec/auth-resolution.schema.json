{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lm15.dev/spec/auth-resolution-vectors-v1.schema.json",
  "title": "Managed auth identity-decision vectors v1 — ratified core",
  "type": "object", "additionalProperties": false,
  "required": ["provenance", "version", "status", "description", "definitions", "cases"],
  "properties": {
    "provenance": {"type": "object", "required": ["source", "date", "evidence"], "properties": {"source": {"const": "hand-authored"}, "date": {"type": "string", "format": "date"}, "evidence": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "version": {"const": 1}, "status": {"const": "ratified-core"}, "description": {"type": "string", "minLength": 1},
    "definitions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/definition"}},
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "given", "expect"], "properties": {"id": {"$ref": "#/$defs/id"}, "given": {"$ref": "#/$defs/given"}, "expect": {"$ref": "#/$defs/expect"}}}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "definition": {
      "type": "object", "additionalProperties": false, "required": ["id", "policy", "env_keys", "binding_id"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "policy": {"enum": ["key", "oauth", "oauth-unless-explicit", "connection", "aws-chain", "azure-chain", "gcp-chain"]}, "env_keys": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "binding_id": {"$ref": "#/$defs/id"}, "placeholder": {"type": "string"}}
    },
    "connection": {
      "type": "object", "additionalProperties": false, "required": ["id", "routes", "state"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "scope": {"$ref": "#/$defs/id"}, "instance_id": {"$ref": "#/$defs/id"}, "routes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "state": {"enum": ["ready", "renewal_due", "needs_login", "indeterminate"]}, "credential_revision": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"}}
    },
    "given": {
      "type": "object", "additionalProperties": false, "required": ["mode", "route"],
      "properties": {
        "mode": {"enum": ["unmanaged", "managed", "bound"]}, "route": {"$ref": "#/$defs/id"}, "model": {"$ref": "#/$defs/id"},
        "scope": {"$ref": "#/$defs/id"}, "instance_id": {"$ref": "#/$defs/id"}, "definition_revision": {"$ref": "#/$defs/id"},
        "explicit": {"type": "object", "additionalProperties": {"oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["ref"], "properties": {"ref": {"$ref": "#/$defs/id"}}},
          {"type": "object", "additionalProperties": false, "required": ["empty"], "properties": {"empty": {"const": true}}}
        ]}},
        "env": {"type": "object", "additionalProperties": {"type": "string"}},
        "named": {"enum": ["platform", "workload", "environment", "cli"]},
        "existing_subscription": {"type": "object", "additionalProperties": false, "required": ["source", "state"], "properties": {"source": {"enum": ["xai-store", "claude-code-cli", "codex-cli"]}, "state": {"enum": ["ready", "renewal_due", "needs_login", "logged_out"]}}},
        "store_error": {"const": "unreadable"},
        "connections": {"type": "array", "items": {"$ref": "#/$defs/connection"}},
        "bound": {"type": "object", "additionalProperties": false, "required": ["connection_id", "route", "model", "definition_revision"], "properties": {"connection_id": {"$ref": "#/$defs/id"}, "route": {"$ref": "#/$defs/id"}, "model": {"$ref": "#/$defs/id"}, "definition_revision": {"$ref": "#/$defs/id"}}}
      },
      "allOf": [{"if": {"properties": {"mode": {"const": "bound"}}}, "then": {"required": ["bound"]}, "else": {"not": {"required": ["bound"]}}}]
    },
    "expect": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["result", "source", "next"], "properties": {"result": {"const": "selected"}, "source": {"enum": ["explicit", "environment", "named_cloud", "cloud_chain", "connection", "existing_subscription", "placeholder"]}, "key": {"$ref": "#/$defs/id"}, "connection_id": {"$ref": "#/$defs/id"}, "next": {"enum": ["acquire", "renew_if_due", "none"]}}, "allOf": [{"if": {"properties": {"source": {"const": "connection"}}}, "then": {"required": ["connection_id"], "not": {"required": ["key"]}}, "else": {"required": ["key"], "not": {"required": ["connection_id"]}}}]},
        {"type": "object", "additionalProperties": false, "required": ["result", "code"], "properties": {"result": {"const": "blocked"}, "code": {"enum": ["auth_operation", "not_configured"]}, "reason": {"enum": ["login_required", "connection_changed", "selection_mismatch", "indeterminate", "storage_unavailable", "interaction_required"]}}, "allOf": [{"if": {"properties": {"code": {"const": "auth_operation"}}}, "then": {"required": ["reason"]}, "else": {"not": {"required": ["reason"]}}}]}
      ]
    }
  }
}
