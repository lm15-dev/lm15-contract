{
 "url": "https://api.openai.com/v1/chat/completions",
 "headers": {
  "Authorization": "$REDACTED",
  "Content-Type": "application/json"
 },
 "body": {
  "model": "gpt-5.6-sol",
  "messages": [
   {
    "role": "user",
    "content": "Extract the person: John is 34 years old, email john@x.io, code ABC. (tools available but not needed)"
   }
  ],
  "max_completion_tokens": 600,
  "tools": [
   {
    "type": "function",
    "function": {
     "name": "lookup",
     "description": "Look up a number.",
     "parameters": {
      "type": "object",
      "properties": {
       "n": {
        "type": "integer"
       }
      },
      "required": [
       "n"
      ]
     }
    }
   }
  ],
  "tool_choice": "auto",
  "response_format": {
   "type": "json_schema",
   "json_schema": {
    "name": "person",
    "schema": {
     "type": "object",
     "properties": {
      "name": {
       "type": "string"
      },
      "age": {
       "type": "integer"
      }
     },
     "required": [
      "name",
      "age"
     ],
     "additionalProperties": false
    },
    "strict": true
   }
  }
 }
}