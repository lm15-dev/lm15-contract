{
  "id": "openai.structured_output",
  "provider": "openai",
  "feature": "structured_output",
  "description": "Structured output via text.format json_schema",
  "request": {
    "method": "POST",
    "url": "https://api.openai.com/v1/responses",
    "headers": {
      "Authorization": "Bearer $OPENAI_API_KEY",
      "Content-Type": "application/json"
    },
    "body": {
      "model": "gpt-4.1-mini",
      "input": [
        {
          "role": "user",
          "content": [
            {
              "type": "input_text",
              "text": "Return a cookie recipe as JSON."
            }
          ]
        }
      ],
      "text": {
        "format": {
          "type": "json_schema",
          "name": "recipe",
          "strict": true,
          "schema": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "ingredients": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "name",
              "ingredients"
            ],
            "additionalProperties": false
          }
        }
      },
      "stream": false
    }
  },
  "expect": {
    "status": 200
  },
  "provenance": {
    "source": "migrated-apr29",
    "date": "2026-06-09",
    "evidence": "lm15-python2/conformance@812a2cb (consolidated corpus, live-validated 2026-04-29 via curl-fixtures pipeline); copied to lm15-contract 2026-06-09"
  }
}
