{
  "id": "openai.multi_turn",
  "provider": "openai",
  "feature": "multi_turn",
  "description": "Multiple user/assistant messages",
  "request": {
    "method": "POST",
    "url": "https://api.openai.com/v1/responses",
    "headers": {
      "Authorization": "Bearer $OPENAI_API_KEY",
      "Content-Type": "application/json"
    },
    "body": {
      "model": "gpt-4.1-mini",
      "input": [
        {
          "role": "user",
          "content": [
            {
              "type": "input_text",
              "text": "What is 2 + 2? Reply with one word."
            }
          ]
        },
        {
          "role": "assistant",
          "content": [
            {
              "type": "output_text",
              "text": "four"
            }
          ]
        },
        {
          "role": "user",
          "content": [
            {
              "type": "input_text",
              "text": "Repeat your previous answer in uppercase."
            }
          ]
        }
      ],
      "stream": false
    }
  },
  "expect": {
    "status": 200
  },
  "provenance": {
    "source": "migrated-apr29",
    "date": "2026-06-09",
    "evidence": "lm15-python2/conformance@812a2cb (consolidated corpus, live-validated 2026-04-29 via curl-fixtures pipeline); copied to lm15-contract 2026-06-09"
  }
}
