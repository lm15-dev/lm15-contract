{
  "id": "xai.structured_output",
  "provider": "xai",
  "feature": "structured_output",
  "description": "Canonical json_schema on xAI (chat dialect) → response_format.json_schema; the schema is guaranteed for supported keywords (docs.x.ai)",
  "request": {
    "method": "POST",
    "url": "https://api.x.ai/v1/chat/completions",
    "headers": {
      "Authorization": "Bearer $XAI_API_KEY",
      "Content-Type": "application/json"
    },
    "body": {
      "model": "grok-4.3",
      "messages": [
        {
          "role": "user",
          "content": "Extract the person: John is 34 years old."
        }
      ],
      "max_tokens": 100,
      "response_format": {
        "type": "json_schema",
        "json_schema": {
          "name": "person",
          "schema": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "age": {
                "type": "integer"
              }
            },
            "required": [
              "name",
              "age"
            ],
            "additionalProperties": false
          },
          "strict": true
        }
      }
    }
  },
  "expect": {
    "status": 200
  },
  "expect_lm15": {
    "parts": {
      "text": {
        "min": 1
      }
    },
    "finish_reason": "stop",
    "usage": {
      "required": true
    }
  },
