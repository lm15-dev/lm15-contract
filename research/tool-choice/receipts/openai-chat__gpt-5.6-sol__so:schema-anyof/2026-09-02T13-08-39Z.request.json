{
 "url": "https://api.openai.com/v1/chat/completions",
 "headers": {
  "Authorization": "$REDACTED",
  "Content-Type": "application/json"
 },
 "body": {
  "model": "gpt-5.6-sol",
  "messages": [
   {
    "role": "user",
    "content": "Extract the person: John, age unknown."
   }
  ],
  "max_tokens": 600,
  "response_format": {
   "type": "json_schema",
   "json_schema": {
    "name": "person",
    "schema": {
     "type": "object",
     "properties": {
      "name": {
       "type": "string"
      },
      "age": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "name",
      "age"
     ],
     "additionalProperties": false
    },
    "strict": true
   }
  }
 }
}