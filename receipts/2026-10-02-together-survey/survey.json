{
  "spec": {
    "id": "together",
    "name": "Together AI",
    "dialect": "openai-chat",
    "base_url": "https://api.together.ai/v1",
    "env_key": "TOGETHER_API_KEY",
    "console_url": "https://api.together.ai/settings/projects/~current/api-keys",
    "terms_url": null,
    "litellm_prefix": "together_ai",
    "models": {
      "plain": "meta-llama/Llama-3.3-70B-Instruct-Turbo",
      "reasoner": "openai/gpt-oss-120b",
      "off": "deepseek-ai/DeepSeek-V4.1-Flash",
      "replayer": "deepseek-ai/DeepSeek-V4.1-Flash",
      "always_on": "zai-org/GLM-5.3-Flash"
    }
  },
  "cap_field": "max_completion_tokens",
  "probes": [
    "cap-max_completion_tokens",
    "cap-max_tokens",
    "cors"
  ],
  "date": "2026-10-02"
}
