{
  "id": "openai_chat.ingest_assistant_null_content",
  "provider": "openai_chat",
  "feature": "ingest_assistant_null_content",
  "surface": "ingest",
  "description": "An assistant row with content null and no tool calls (some transcripts carry one) reads as one empty TextPart: Message.parts is never empty (MAP-2 applied to history). An empty string reads the same way.",
  "body": {
    "model": "gpt-5-mini",
    "messages": [
      {
        "role": "user",
        "content": "Hi"
      },
      {
        "role": "assistant",
        "content": null
      },
      {
        "role": "user",
        "content": "?"
      },
      {
        "role": "assistant",
        "content": ""
      },
      {
        "role": "user",
        "content": "??"
      }
    ]
  },
  "expect_lm15": {
    "canonical_request": {
      "model": "gpt-5-mini",
      "messages": [
        {
          "role": "user",
          "parts": [
            {
              "type": "text",
              "text": "Hi"
            }
          ]
        },
        {
          "role": "assistant",
          "parts": [
            {
              "type": "text",
              "text": ""
            }
          ]
        },
        {
          "role": "user",
          "parts": [
            {
              "type": "text",
              "text": "?"
            }
          ]
        },
        {
          "role": "assistant",
          "parts": [
            {
              "type": "text",
              "text": ""
            }
          ]
        },
        {
          "role": "user",
          "parts": [
            {
              "type": "text",
              "text": "??"
            }
          ]
        }
      ]
    }
  },
  "provenance": {
