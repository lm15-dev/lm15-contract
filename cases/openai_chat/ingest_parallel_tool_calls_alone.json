{
  "id": "openai_chat.ingest_parallel_tool_calls_alone",
  "provider": "openai_chat",
  "feature": "ingest_parallel_tool_calls_alone",
  "surface": "ingest",
  "description": "parallel_tool_calls without a tool_choice (what DSPy's adapters send) reads as ToolChoice(mode=auto, parallel=false): the preference has a slot only on a ToolChoice, so one is created at the wire's default mode.",
  "body": {
    "model": "gpt-5-mini",
    "messages": [
      {
        "role": "user",
        "content": "Weather in Paris?"
      }
    ],
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "get_weather",
          "description": "Current weather for a city.",
          "parameters": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string"
              }
            },
            "required": [
              "city"
            ]
          }
        }
      }
    ],
    "parallel_tool_calls": false
  },
  "expect_lm15": {
    "canonical_request": {
      "model": "gpt-5-mini",
      "messages": [
        {
          "role": "user",
          "parts": [
            {
              "type": "text",
              "text": "Weather in Paris?"
            }
          ]
        }
      ],
      "tools": [
        {
          "type": "function",
          "name": "get_weather",
          "description": "Current weather for a city.",
          "parameters": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string"
              }
            },
            "required": [
              "city"
            ]
          }
        }
      ],
      "config": {
        "tool_choice": {
          "mode": "auto",
          "parallel": false
        }
      }
    }
  },
  "provenance": {
    "source": "hand-authored",
    "date": "2026-09-08",
    "evidence": "MAP-12 design (changes/2026-09-08-openai-chat-ingest.md (MAP-12, pending ratification)); the body follows scrapes/openai/pages/chat--create.md § Body Parameters; the expectation was written by hand and checked against the reference shim on 2026-09-08 (reference agrees with the hand-authored canonical request)"
  }
}
