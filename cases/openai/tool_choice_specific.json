{
  "id": "openai.tool_choice_specific",
  "provider": "openai",
  "feature": "tool_choice_specific",
  "description": "Force a specific function tool call",
  "request": {
    "method": "POST",
    "url": "https://api.openai.com/v1/responses",
    "headers": {
      "Authorization": "Bearer $OPENAI_API_KEY",
      "Content-Type": "application/json"
    },
    "body": {
      "model": "gpt-4.1-mini",
      "input": [
        {
          "role": "user",
          "content": [
            {
              "type": "input_text",
              "text": "Get the weather in Montreal."
            }
          ]
        }
      ],
      "tools": [
        {
          "type": "function",
          "name": "get_weather",
          "description": "Get the current weather for a city",
          "parameters": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string"
              }
            },
            "required": [
              "city"
            ]
          }
        }
      ],
      "tool_choice": {
        "type": "function",
        "name": "get_weather"
      },
      "stream": false
    }
  },
  "expect": {
    "status": 200
  },
  "provenance": {
    "source": "migrated-apr29",
    "date": "2026-06-09",
    "evidence": "lm15-python2/conformance@812a2cb (consolidated corpus, live-validated 2026-04-29 via curl-fixtures pipeline); copied to lm15-contract 2026-06-09"
  }
}
